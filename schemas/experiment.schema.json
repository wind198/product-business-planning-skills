{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "hypothesis_ref",
    "method",
    "success_criteria",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^EXP-[0-9]{3,}$"
    },
    "hypothesis_ref": {
      "type": "string"
    },
    "method": {
      "type": "string"
    },
    "success_criteria": {
      "type": "string"
    },
    "status": {
      "enum": [
        "planned",
        "running",
        "completed",
        "cancelled"
      ]
    },
    "sample": {
      "type": [
        "string",
        "null"
      ]
    },
    "result": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "learning": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
